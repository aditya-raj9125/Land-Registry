# ═══════════════════════════════════════════════════════════
# BhoomiChain Environment Variables — DO NOT COMMIT THIS FILE
# ═══════════════════════════════════════════════════════════

# ── Blockchain ────────────────────────────────────────────
ALCHEMY_API_KEY=your_alchemy_api_key_here
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Contract Addresses (filled after deployment)
LAND_REGISTRY_ADDRESS=
TRANSFER_DEED_ADDRESS=
STAMP_DUTY_ADDRESS=
DISPUTE_ORACLE_ADDRESS=
IDENTITY_VERIFIER_ADDRESS=
LAND_AUCTION_ADDRESS=
AUDIT_LOGGER_ADDRESS=

# ── Frontend (Next.js Public) ─────────────────────────────
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LAND_REGISTRY_ADDRESS=
NEXT_PUBLIC_TRANSFER_DEED_ADDRESS=

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bhoomichain
# Supabase (production):
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ── Redis (Upstash for production) ───────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://:[token]@[host]:6380

# ── Authentication ────────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ── File Storage (web3.storage / IPFS) ───────────────────
WEB3_STORAGE_TOKEN=your_web3_storage_token_here

# ── Government APIs ───────────────────────────────────────
DILRMP_API_URL=https://sandbox.dilrmp.gov.in/api
DILRMP_API_KEY=your_dilrmp_api_key
UIDAI_SANDBOX_URL=https://stage1.aadhaarapi.com
UIDAI_CLIENT_ID=your_uidai_client_id
ECOURTS_API_URL=https://api.ecourts.gov.in

# ── Notifications ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=noreply@bhoomichain.in

# ── Monitoring ────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
POSTHOG_API_KEY=phc_your_posthog_key

# ── API Server ────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# ── Meilisearch ───────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key
